# 应用页面包（PWA）的构建期默认安装元信息。默认值来自 web/src/i18n/zh.json，
# 下面三项非空时在构建期覆盖对应字段；写在构建机的 web/.env 或 web/.env.local 里。
# 这只影响构建产物的默认值：服务器 /etc/calmobile.env 里的同名变量会在启动时
# 生成实例专属的 manifest/标题，优先级高于这里。不要在页面源码里另写一套名字。
# 不要提交 .env / .env.local（已在 .gitignore 里忽略）。
# 运行时品牌还支持 APP_TITLE、JOIN_TITLE、PWA_LANG、PWA_THEME_COLOR 等，
# 见 server/.env.example 的「运行时品牌」一节。

# 应用名：manifest.name 与浏览器页签标题（默认 zh.json 的 app.documentTitle）
PWA_APP_NAME=
# 短名：manifest.short_name 与 apple-mobile-web-app-title（默认 zh.json 的 pwa.manifest.shortName）
PWA_APP_SHORT_NAME=
# 描述：manifest.description 与 meta name="description"（默认 zh.json 的 pwa.manifest.description）
PWA_APP_DESCRIPTION=

# 安装图标不在这里配：APP_ICON / APP_ICON_BACKGROUND 由 scripts/build-icons.mjs 读取
# server/.env 或构建进程环境，这样同一份源图能同时生成 PWA 与 Android 图标。
