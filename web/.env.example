# 应用页面包（PWA）的安装元信息。默认值来自 web/src/i18n/zh.json，
# 下面三项非空时在构建期覆盖对应字段；写在构建机的 web/.env 或 web/.env.local 里。
# 只影响构建产物（页面标题、manifest、meta），不要在页面源码里另写一套名字。
# 不要提交 .env / .env.local（已在 .gitignore 里忽略）。

# 应用名：manifest.name 与浏览器页签标题（默认 zh.json 的 app.documentTitle）
PWA_APP_NAME=
# 短名：manifest.short_name 与 apple-mobile-web-app-title（默认 zh.json 的 pwa.manifest.shortName）
PWA_APP_SHORT_NAME=
# 描述：manifest.description 与 meta name="description"（默认 zh.json 的 pwa.manifest.description）
PWA_APP_DESCRIPTION=
