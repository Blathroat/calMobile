    "zxing-wasm": "3.1.5"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/turndown": "5.0.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/tsconfig": "0.9.1",
    "jsdom": "30.1.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "vue-tsc": "3.3.13"
