# 每台生产机器都一样的非密钥项。部署只补服务器上还没有的键，不覆盖已有值。
# 域名、数据库主机、发件人地址和口令不写在这里。
NODE_ENV=production
PORT=3000
ENABLE_WEB=true
ENABLE_STATUS_PAGE=false
ENABLE_HEALTH=false
TRUST_PROXY=1
# 经 Cloudflare 转发时按 CF-Connecting-IP 记真实客户端地址（最近登录地区、限流、日志都用它）。
# 只在源站只接受 Cloudflare 与反代流量时保持 1；不走 Cloudflare 的实例改成 0。
TRUST_CLOUDFLARE=1
CORS_ORIGIN=https://appassets.androidplatform.net
LOG_LEVEL=info
MAIL_TRANSPORT=smtp

# ── 实例身份与更新器（CALMOBILE_*）────────────────────────────────
# 服务器运行配置统一在 /etc/calmobile.env，更新器也从同一份文件读这些键。
# 旧版 /etc/calmobile-update.json 已废弃：下面这些键就是它的替代（对照见
# deploy/instance.env.example）。更新器按「默认值 < env 文件 < 进程环境变量 < 命令行」
# 取值；命令行的 --env-file / --root / --service 可临时覆盖。
# 系统单元由 deploy/systemd/*.in 渲染，身份与路径都从这里取：
#   node scripts/render-units.mjs --env-file /etc/calmobile.env --out /etc/systemd/system
# 改 User / Group / 路径、服务名或 env 文件位置后要重新渲染并 daemon-reload；不改就沿用
# 这里的默认值。
CALMOBILE_PACKAGE=calmobile-server
CALMOBILE_REGISTRY=https://registry.npmjs.org
CALMOBILE_ROOT=/opt/calmobile
CALMOBILE_KEEP=3
CALMOBILE_HEALTH_URL=http://127.0.0.1:3000/ping
CALMOBILE_APP_URL=http://127.0.0.1:3000/app/release.json
CALMOBILE_SERVICE=calmobile.service
CALMOBILE_UPDATE_SERVICE=calmobile-update.service
CALMOBILE_ENV_FILE=/etc/calmobile.env
CALMOBILE_UPDATER_PATH=/usr/local/lib/calmobile/calmobile-update.mjs
CALMOBILE_MIN_FREE_MB=512
# 运行服务与更新的系统账号；首次部署时按机器改成实际用户。
CALMOBILE_USER=blathroat
CALMOBILE_GROUP=blathroat
CALMOBILE_NODE=/usr/bin/node
CALMOBILE_REPOSITORY_URL=https://github.com/Blathroat/calMobile
