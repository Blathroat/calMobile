# calMobile 实例环境文件示例（复制成 /etc/calmobile.env）
#
# 服务器运行、更新器和 systemd 单元都只认这一份配置。更新器每次更新只把
# deploy/production.env 里有、而服务器上还没有的键补进来，不覆盖已有值，
# 文件里多出来的键也保留。空的密钥不会写入，必填密钥缺失时更新在合并环境文件
# 阶段就中止，不切换版本。
#
# 本文件只是示例：口令和密钥都要换成本机真实值，不要把真实 /etc/calmobile.env
# 提交进仓库。部署后确认权限是 root:root 600；要改一个已经存在的值，直接改
# 服务器上的 /etc/calmobile.env 并重启服务，更新器不会覆盖它。
#
# 应用自身的完整变量说明见 server/.env.example；这里只列实例必填、常用可选和
# 更新器/单元渲染用的 CALMOBILE_* 键。

# ── 必填：安全与初始管理员 ─────────────────────────────────────
# JWT_SECRET / TOTP_SECRET_KEY 各自至少 32 个随机字符；TOTP_SECRET_KEY 必须长期
# 保管，已绑定的验证器靠它解密。ADMIN_* 只在这个用户名还不存在时创建。
JWT_SECRET=请替换为至少32位的随机字符串
TOTP_SECRET_KEY=请替换为至少32位的随机字符串
DB_PASSWORD=请替换为数据库口令
MAIL_SMTP_PASSWORD=请替换为邮件中继口令
ADMIN_USERNAME=opsadmin
ADMIN_PASSWORD=请替换为12到32位且不是示例值的口令
ADMIN_EMAIL=ops@example.com

# ── 对外地址与反向代理 ────────────────────────────────────────
# PUBLIC_BASE_URL 决定分享链接、canonical 跳转和 WebAuthn 默认来源，必须与用户
# 实际访问的域名一致；APP_API_BASE 只给 APK 外壳与开发代理用，不进入页面包。
PUBLIC_BASE_URL=https://app.example.com
APP_API_BASE=https://app.example.com/api/v1
# TRUST_PROXY=1、TRUST_CLOUDFLARE=0 已由 deploy/production.env 带上；只有经
# Cloudflare 转发且源站只接受 Cloudflare 与反代流量时才把 TRUST_CLOUDFLARE 改成 1。
# FORCE_HTTPS=1
# HSTS_MAX_AGE=15552000
# PRIVACY_POLICY_URL=https://app.example.com/privacy

# ── 数据库 ───────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=calmobile
DB_USER=calmobile
# 托管数据库一般要求 TLS；同机 Docker 的 PostgreSQL 不带 TLS，保持注释掉。
# DB_SSL=true

# ── 邮件（验证码与两步验证）──────────────────────────────────
MAIL_TRANSPORT=smtp
MAIL_SMTP_HOST=smtp.example.com
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURE=true
MAIL_SMTP_USER=ops@example.com
MAIL_FROM_ADDRESS=no-reply@example.com
# MAIL_REPLY_TO=

# ── 常用可选项 ───────────────────────────────────────────────
# 上传目录放部署目录外面，不随版本切换。
# UPLOAD_DIR=/var/lib/calmobile/uploads
# UPLOAD_MAX_MB=20
# MEDIA_BASE_URL=https://app.example.com
# LANG_PACK_DEFAULT=en
# LANG_PACK_URLS=en=https://example.com/en.json, ja=https://example.com/ja.json
# 通行密钥的依赖方 ID 必须与页面域名一致；App 内使用还要在 WEBAUTHN_ORIGINS
# 里加上 android:apk-key-hash:<签名证书 SHA-256 的 base64url>。
# WEBAUTHN_RP_ID=app.example.com
# WEBAUTHN_ORIGINS=https://app.example.com
#
# 运行时品牌与图标：不配就沿用构建期产物；配了以后服务启动时生成实例页面层，
# 改完要重启服务。APP_ICON 在运行时相对运行时包根或写绝对路径。
# PWA_APP_NAME=活动排期助手
# PWA_APP_SHORT_NAME=青枳
# PWA_APP_DESCRIPTION=青枳 · 活动日历、报名与展商管理
# APP_TITLE=青枳 · 活动排期助手
# JOIN_TITLE=青枳
# PWA_LANG=zh-CN
# PWA_THEME_COLOR=#FDCC32
# PWA_THEME_COLOR_DARK=#101215
# PWA_BACKGROUND_COLOR=#f7f6f3
# APP_ICON=/etc/calmobile/icon.png
# APP_ICON_BACKGROUND=#41707e
# APP_ICON_TRANSPARENT=1
# PWA_ICON_DIR=/etc/calmobile/icons

# ── 实例身份、更新器与单元模板（CALMOBILE_*）─────────────────
# 更新器（/usr/local/lib/calmobile/calmobile-update.mjs）和
# scripts/render-units.mjs 都从这份文件读这些键；旧版 /etc/calmobile-update.json
# 已废弃，不再读取。键名与旧 JSON 字段的对照见文件末尾。
CALMOBILE_PACKAGE=calmobile-server
CALMOBILE_REGISTRY=https://registry.npmjs.org
CALMOBILE_ROOT=/opt/calmobile
CALMOBILE_KEEP=3
CALMOBILE_HEALTH_URL=http://127.0.0.1:3000/ping
CALMOBILE_APP_URL=http://127.0.0.1:3000/app/release.json
CALMOBILE_SERVICE=calmobile.service
CALMOBILE_UPDATE_SERVICE=calmobile-update.service
CALMOBILE_ENV_FILE=/etc/calmobile.env
CALMOBILE_UPDATER_PATH=/usr/local/lib/calmobile/calmobile-update.mjs
CALMOBILE_MIN_FREE_MB=512
# 运行服务与更新的系统账号；改完用下面的命令重新渲染单元并让 systemd 重读。
CALMOBILE_USER=blathroat
CALMOBILE_GROUP=blathroat
CALMOBILE_NODE=/usr/bin/node
CALMOBILE_REPOSITORY_URL=https://github.com/Blathroat/calMobile
#
# 重新渲染 systemd 单元（输出目录按发行版调整）：
#   node scripts/render-units.mjs --env-file /etc/calmobile.env --out /etc/systemd/system
#   systemctl daemon-reload
#
# 旧 /etc/calmobile-update.json 字段 → CALMOBILE_* 键：
#   package      → CALMOBILE_PACKAGE
#   registry     → CALMOBILE_REGISTRY
#   root         → CALMOBILE_ROOT
#   keep         → CALMOBILE_KEEP
#   healthUrl    → CALMOBILE_HEALTH_URL
#   appUrl       → CALMOBILE_APP_URL
#   service      → CALMOBILE_SERVICE
#   envFile      → CALMOBILE_ENV_FILE
#   updaterPath  → CALMOBILE_UPDATER_PATH
#   minFreeMb    → CALMOBILE_MIN_FREE_MB
# 新增（旧 JSON 里没有对应字段）：
#   CALMOBILE_USER / CALMOBILE_GROUP / CALMOBILE_NODE /
#   CALMOBILE_REPOSITORY_URL / CALMOBILE_UPDATE_SERVICE
