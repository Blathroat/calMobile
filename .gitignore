# ── 构建产物 ──────────────────────────────────────────────────────
.gradle/
build/
**/build/
*.apk
*.aab
*.ap_
*.hprof
captures/
.cxx/
.externalNativeBuild/

# ── 本机配置（各人环境不同，不入库） ──────────────────────────────
local.properties
gradle-local/
.gradle-local/
# Gradle 自动供给 toolchain 时生成的守护进程 JVM 配置：里面钉着本机的 JDK 厂商与版本
gradle/gradle-daemon-jvm.properties

# 后端依赖与本机配置：node_modules 体积大，.env 里有数据库口令与 JWT 密钥
node_modules/
server/.env
.env
.env.local

# 后端 tsc 编译产物（pnpm build → server/dist，镜像 src/）
server/dist/
server/src/status-page-assets.ts
*.tsbuildinfo

# ── IDE 工程文件：由 IDE 自行生成，不入库 ────────────────────────
.idea/
*.iml

# ── 运行记录、本地工具与日志 ─────────────────────────────────────
.omo/
.opencode/
.codegraph/
.agents/
.claude/
.grok/
skills-lock.json
*.log
npm-debug.log*
pnpm-debug.log*

# ── 系统文件 ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
