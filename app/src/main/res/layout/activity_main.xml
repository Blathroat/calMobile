<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background"
    android:orientation="vertical">

    <!-- Scrollable content area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_20dp"
            android:paddingTop="@dimen/spacing_24dp"
            android:paddingBottom="@dimen/spacing_32dp">

            <!-- Header section -->
            <TextView
                android:id="@+id/title_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.Headline" />

            <TextView
                android:id="@+id/status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4dp"
                android:textAppearance="@style/TextAppearance.Subtitle" />

            <!-- Search entry bar -->
            <LinearLayout
                android:id="@+id/home_search_bar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_16dp"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:elevation="@dimen/elevation_low"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/search_hint"
                    android:textColor="@color/text_hint"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="@dimen/icon_size_medium"
                    android:layout_height="@dimen/icon_size_medium"
                    android:contentDescription="@string/search_btn"
                    android:src="@android:drawable/ic_menu_search"
                    android:tint="@color/text_tertiary" />
            </LinearLayout>

            <!-- Calendar section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_28dp"
                android:background="@drawable/bg_card"
                android:elevation="@dimen/elevation_low"
                android:orientation="vertical"
                android:padding="@dimen/spacing_16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/month_view_title"
                    android:textAppearance="@style/TextAppearance.Title" />

                <GridLayout
                    android:id="@+id/calendar_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_12dp"
                    android:alignmentMode="alignMargins"
                    android:columnCount="7"
                    android:rowCount="5"
                    android:useDefaultMargins="false" />
            </LinearLayout>

            <!-- Today's exhibitions section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_28dp"
                android:text="@string/today_exhibitions"
                android:textAppearance="@style/TextAppearance.Title" />

            <LinearLayout
                android:id="@+id/exhibition_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8dp"
                android:orientation="vertical" />

            <!-- My registrations section -->
            <TextView
                android:id="@+id/my_registrations_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_28dp"
                android:text="@string/my_registrations_title"
                android:textAppearance="@style/TextAppearance.Title" />

            <LinearLayout
                android:id="@+id/my_registrations_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8dp"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

    <!-- Fixed bottom navigation bar -->
    <include layout="@layout/layout_bottom_nav" />

</LinearLayout>
