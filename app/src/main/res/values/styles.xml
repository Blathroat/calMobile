<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.Headline" parent="">
        <item name="android:textSize">28sp</item><item name="android:textColor">@color/text_primary</item><item name="android:textStyle">bold</item><item name="android:lineSpacingMultiplier">1.14</item><item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="TextAppearance.Title" parent="">
        <item name="android:textSize">20sp</item><item name="android:textColor">@color/text_primary</item><item name="android:textStyle">bold</item><item name="android:lineSpacingMultiplier">1.2</item>
    </style>
    <style name="TextAppearance.TitleMedium" parent="">
        <item name="android:textSize">16sp</item><item name="android:textColor">@color/text_primary</item><item name="android:textStyle">bold</item><item name="android:lineSpacingMultiplier">1.25</item>
    </style>
    <style name="TextAppearance.Body" parent="">
        <item name="android:textSize">15sp</item><item name="android:textColor">@color/text_primary</item><item name="android:lineSpacingMultiplier">1.42</item>
    </style>
    <style name="TextAppearance.BodySmall" parent="">
        <item name="android:textSize">14sp</item><item name="android:textColor">@color/text_secondary</item><item name="android:lineSpacingMultiplier">1.38</item>
    </style>
    <style name="TextAppearance.Label" parent="">
        <item name="android:textSize">13sp</item><item name="android:textColor">@color/text_secondary</item><item name="android:textStyle">bold</item><item name="android:letterSpacing">0.025</item>
    </style>
    <style name="TextAppearance.Caption" parent="">
        <item name="android:textSize">12sp</item><item name="android:textColor">@color/text_tertiary</item><item name="android:lineSpacingMultiplier">1.3</item>
    </style>
    <style name="TextAppearance.Subtitle" parent="">
        <item name="android:textSize">16sp</item><item name="android:textColor">@color/text_secondary</item><item name="android:lineSpacingMultiplier">1.35</item>
    </style>

    <style name="Widget.CalMobile.Button.Primary" parent="android:Widget.Button">
        <item name="android:background">@drawable/bg_button_primary</item><item name="android:textColor">@color/button_primary_text</item><item name="android:textSize">14sp</item><item name="android:textStyle">bold</item><item name="android:textAllCaps">false</item><item name="android:paddingLeft">@dimen/spacing_16dp</item><item name="android:paddingRight">@dimen/spacing_16dp</item><item name="android:minHeight">@dimen/button_height</item><item name="android:elevation">@dimen/elevation_none</item><item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Widget.CalMobile.Button.Secondary" parent="android:Widget.Button">
        <item name="android:background">@drawable/bg_button_secondary</item><item name="android:textColor">@color/button_secondary_text</item><item name="android:textSize">14sp</item><item name="android:textAllCaps">false</item><item name="android:paddingLeft">@dimen/spacing_16dp</item><item name="android:paddingRight">@dimen/spacing_16dp</item><item name="android:minHeight">@dimen/button_height</item><item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Widget.CalMobile.Button.Text" parent="android:Widget.Button">
        <item name="android:background">@drawable/bg_button_text</item><item name="android:textColor">@color/primary</item><item name="android:textSize">14sp</item><item name="android:textAllCaps">false</item><item name="android:paddingLeft">@dimen/spacing_16dp</item><item name="android:paddingRight">@dimen/spacing_16dp</item><item name="android:minHeight">44dp</item><item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Widget.CalMobile.Button.Danger" parent="android:Widget.Button">
        <item name="android:background">@drawable/bg_button_danger</item><item name="android:textColor">@color/button_danger_text</item><item name="android:textSize">15sp</item><item name="android:textAllCaps">false</item><item name="android:paddingLeft">@dimen/spacing_20dp</item><item name="android:paddingRight">@dimen/spacing_20dp</item><item name="android:minHeight">@dimen/button_height</item><item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Widget.CalMobile.Button.Logout" parent="android:Widget.Button">
        <item name="android:background">@drawable/bg_button_text</item><item name="android:textColor">@color/status_closed</item><item name="android:textSize">15sp</item><item name="android:textStyle">bold</item><item name="android:textAllCaps">false</item><item name="android:minHeight">@dimen/button_height</item><item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Widget.CalMobile.EditText" parent="android:Widget.EditText">
        <item name="android:background">@drawable/bg_input_field</item><item name="android:textColor">@color/text_primary</item><item name="android:textColorHint">@color/text_hint</item><item name="android:textSize">15sp</item><item name="android:paddingLeft">@dimen/spacing_16dp</item><item name="android:paddingRight">@dimen/spacing_16dp</item><item name="android:paddingTop">@dimen/spacing_14dp</item><item name="android:paddingBottom">@dimen/spacing_14dp</item><item name="android:minHeight">@dimen/input_height</item>
    </style>
    <style name="Widget.CalMobile.Card" parent="">
        <item name="android:background">@drawable/bg_card</item><item name="android:padding">@dimen/spacing_16dp</item><item name="android:elevation">@dimen/elevation_low</item>
    </style>
    <style name="Widget.CalMobile.Tab" parent="android:Widget.Button">
        <item name="android:background">@drawable/bg_tab_inactive</item><item name="android:textColor">@color/tab_inactive_text</item><item name="android:textSize">13sp</item><item name="android:textAllCaps">false</item><item name="android:textStyle">bold</item><item name="android:minHeight">@dimen/button_height_small</item>
    </style>
    <style name="Widget.CalMobile.Chip" parent="android:Widget.Button">
        <item name="android:background">@drawable/bg_chip</item><item name="android:textColor">@color/chip_text</item><item name="android:textSize">13sp</item><item name="android:textAllCaps">false</item><item name="android:paddingLeft">@dimen/spacing_14dp</item><item name="android:paddingRight">@dimen/spacing_14dp</item>
    </style>
    <style name="Widget.CalMobile.BackButton" parent="">
        <item name="android:textColor">@color/back_button_tint</item><item name="android:textSize">14sp</item><item name="android:gravity">center</item><item name="android:minHeight">44dp</item>
    </style>
    <style name="Widget.CalMobile.StatusBadge" parent="">
        <item name="android:background">@drawable/bg_status_badge</item><item name="android:textColor">@color/status_open</item><item name="android:textSize">12sp</item><item name="android:textStyle">bold</item><item name="android:paddingLeft">@dimen/spacing_10dp</item><item name="android:paddingRight">@dimen/spacing_10dp</item><item name="android:paddingTop">@dimen/spacing_4dp</item><item name="android:paddingBottom">@dimen/spacing_4dp</item>
    </style>
</resources>
