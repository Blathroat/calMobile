<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Notification permission for API 33+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Calendar permissions for adding exhibitions to device calendar -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- 展商核销报名码时需要摄像头；不是必需硬件，没有摄像头的设备仍可手动输入报名码 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- 访问演示后端（HTTP）：模拟器用 10.0.2.2，真机用 adb reverse 的 127.0.0.1。
         接入正式后端并改用 HTTPS 后应当去掉这一行。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".CalMobileApp"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <!-- WebView 前端容器：唯一入口，承载应用的全部页面。 -->
        <activity
            android:name=".WebShellActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
