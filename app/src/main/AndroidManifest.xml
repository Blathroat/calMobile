<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Notification permission for API 33+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Calendar permissions for adding exhibitions to device calendar -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- 展商核销报名码时需要摄像头；不是必需硬件，没有摄像头的设备仍可手动输入报名码 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".CalMobileApp"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <!-- WebView 前端容器：唯一入口，承载 newUI 的全部页面 -->
        <activity
            android:name=".WebShellActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 以下原生页面保留编译与清单注册，仅用于对照与回退，不再由启动入口进入 -->
        <activity android:name=".LoginActivity" />
        <activity android:name=".RegisterActivity" />
        <activity android:name=".MainActivity" />
        <activity android:name=".ProfileActivity" />
        <activity android:name=".UserPublicActivity" />
        <activity android:name=".ExhibitorBackendActivity" />
        <activity android:name=".ExhibitionFormActivity" />
        <activity android:name=".RichDescriptionEditorActivity" />
        <activity android:name=".RegistrationManagementActivity" />
        <activity android:name=".RegistrationDetailActivity" />
        <activity android:name=".MyRegistrationsActivity" />
        <activity android:name=".MyRegistrationDetailActivity" />
        <activity android:name=".AdminBackendActivity" />
        <activity android:name=".SearchActivity" />
        <activity android:name=".ExhibitionDetailActivity" />
        <activity android:name=".RegistrationFormActivity" />
    </application>

</manifest>
