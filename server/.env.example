# 服务器配置。PORT 同时是 API 和浏览器报名站的端口，改这里即可，不要再加第二个端口。
PORT=3000
# pnpm start 会传 --production 覆盖这里；pnpm dev 用这个值（development）
NODE_ENV=development

# 下列开关空着就按环境取默认。生产（pnpm start）默认：状态页关、/health 关、报名站关、/ping 开。
# 开发默认除了显式关掉的项以外都开。true / false / 1 / 0 都可以。
#
# 状态页（/status 与 /api/v1/status）会列出迁移、各表行数和接口。打开前确认外部访问不到。
# ENABLE_STATUS_PAGE=true
# 对外存活探针。公网探活只用这个。
# ENABLE_PING=true
# /health 的响应里带进程运行时间，生产默认关闭。
# ENABLE_HEALTH=false
# 浏览器报名站。生产要对外提供时设 true，并先执行 pnpm build（缺少 web/dist-join 会拒绝启动）。
# ENABLE_WEB=false
#
# 生产初始管理员。只在这个用户名还不存在时创建，之后改密码走应用，环境变量不会覆盖。
# 用户名 3–20 位；密码 12–32 位，不要用 password / admin 这类示例口令；邮箱要能收信。
# ADMIN_USERNAME=opsadmin
# ADMIN_PASSWORD=
# ADMIN_EMAIL=ops@你的域名

# 反向代理：前面有代理时设为 1，否则 req.ip 是代理地址，按 IP 的验证码限流会退化成全局额度
# TRUST_PROXY=1

# ── 对外部署（域名 / TLS / 上传）─────────────────────────────────
# 这些都是**可选的**：不配就是当前这套「本机 http + 设备本地媒体」的开发形态。
# 完整清单与 nginx 片段见 docs/operations.md 的「上线」一节。
#
# 对外访问地址。报名站的规范来源和分享链接都用它：
# 页面请求的 Host 与它不一致时 308 到这里（/api、/media、/ping、/health、/status 不跳转），
# 分享出去的报名链接是 {PUBLIC_BASE_URL}/e/{展会 id}。
# 只在 http(s)://host[:port] 形式下生效，非法值当没配。没配时不跳转，也不生成 127.0.0.1 链接。
# 状态页、/ping 和邮件里的绝对地址同样用它。
# PUBLIC_BASE_URL=https://app.example.com
#
# 反代已终止 TLS 时打开：明文请求（X-Forwarded-Proto: http）会 308 跳到 https。
# **直连部署不要开**，那会把请求跳到一个并不存在的 https 端口上。
# FORCE_HTTPS=1
#
# HSTS 的 max-age（秒）。默认 180 天；填 0 表示不下发这个头（域名没定或本地 http 调试时）。
# 只应在确认全站 HTTPS 可用之后再下发长 max-age。
# HSTS_MAX_AGE=15552000
#
# 应用包里的接口地址。不配时打进 APK 的是 http://127.0.0.1:${PORT}/api/v1（配合 adb reverse）。
# 正式包必须是公网 https，路径固定 /api/v1，并且和 PUBLIC_BASE_URL 同一个源。
# 改完要重新构建 APK。进程里已有的同名变量优先于这个文件。
# APP_API_BASE=https://app.example.com/api/v1
#
# 注册页的隐私政策链接，必须是 https。不配时注册页只显示收集说明。
# PRIVACY_POLICY_URL=https://app.example.com/privacy

# ── 通行密钥（WebAuthn / passkey）───────────────────────────────
# 两步验证新增的登录方式。服务端用 @simplewebauthn/server 校验注册与断言，
# 客户端只用浏览器原生 WebAuthn API，不需要额外的原生 SDK。
#
# 依赖方 ID（rpId）：域名或 IP，不带协议与端口。默认取 PUBLIC_BASE_URL 的主机名，
# 没配对外地址时用 localhost。必须与用户打开页面时用的域名一致，
# 否则浏览器签出的响应会被判成「当前地址不允许使用通行密钥」。
# WEBAUTHN_RP_ID=app.example.com
#
# 系统弹窗里显示的服务名。默认取「管理-设置」里的中文标题，读不到用 CalMobile。
# WEBAUTHN_RP_NAME=发现展会
#
# 允许的完整来源（origin），逗号分隔，带协议与端口。默认是 PUBLIC_BASE_URL 的 origin
# 加 http://localhost:<PORT>、http://127.0.0.1:<PORT>（本机调试用）。正式部署填公网地址即可。
# WEBAUTHN_ORIGINS=https://app.example.com

# ── 客户端更新检查 / 软件包下载 ─────────────────────────────────
# 下载源在「管理-设置」里配置（直链或 GitHub 仓库），不读环境变量。
# 选 GitHub 仓库时服务端读 https://api.github.com/repos/<owner>/<repo>/releases/latest，
# 取第一个 .apk 资产；匿名调用有额度限制，配 token 可提高额度（可选）。
# GITHUB_TOKEN=
#
# 应用包名。不配时是 com.blathroat.calmobile。改成 com.example 时 assembleRelease 会拒绝。
# ANDROID_APPLICATION_ID=com.blathroat.calmobile
# ANDROID_VERSION_CODE=1
# ANDROID_VERSION_NAME=0.1.0
#
# 正式签名。四项都配齐，并且文件真实存在，assembleRelease 才会签名。
# ANDROID_KEYSTORE_PATH=
# ANDROID_KEYSTORE_PASSWORD=
# ANDROID_KEY_ALIAS=
# ANDROID_KEY_PASSWORD=
#
# 头像落盘目录。缺省是 server/data/uploads（相对这个包，不跟启动时的工作目录走）。
# UPLOAD_DIR=
# 头像对外绝对前缀，只要 http(s)://主机[:端口]，不要带路径。不配则库存 /media/... ，
# 客户端按 APP_API_BASE 的源补全。没配 APP_API_BASE 时就是 http://127.0.0.1:${PORT}。
# MEDIA_BASE_URL=
# 头像传输硬顶（MB），再与管理设置里的头像大小上限取较小值。缺省并封顶 20。
# UPLOAD_MAX_MB=20

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=calmobile_dev
DB_USER=postgres
DB_PASSWORD=postgres
# 托管数据库一般要求 TLS；同机 Docker 的 PostgreSQL 不带 TLS，所以默认关闭
# DB_SSL=true

# 访问令牌与验证器密钥
# 本地也应设置各自独立的随机值，每个至少 32 个字符。
JWT_SECRET=replace-with-a-random-access-secret-at-least-32-characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL=7d
# 必填；必须长期保管。迁移旧配置时，如果此前没有单独配置 TOTP_SECRET_KEY，
# 将原 JWT_REFRESH_SECRET 的值原样复制到这里，已绑定的验证器才能继续解密。
TOTP_SECRET_KEY=replace-with-a-random-totp-secret-at-least-32-characters

# 邮件配置（验证码与两步验证走这里）
# 通道：console（写日志，本地零配置）| smtp（真发信）| memory（仅测试，生产禁用）
# 开发环境（NODE_ENV=development）发信时，除了走配置的通道，还会把整封邮件（含验证码）
# 再打一份到服务端控制台；生产与测试不打。
# 开发指向 Mailpit：docker compose up -d mailpit（或 pwsh -File scripts\mail.ps1 start；SMTP 1025 / 收件箱 http://127.0.0.1:8025）
# 生产指向托管中继（阿里云邮件推送 / 腾讯云 SES / Resend 等），不要自建 SMTP
MAIL_TRANSPORT=smtp
MAIL_SMTP_HOST=127.0.0.1
MAIL_SMTP_PORT=1025
MAIL_SMTP_SECURE=false
# 生产必须显式配置发件人地址，并用该域名的 SPF / DKIM 记录
MAIL_FROM_ADDRESS=no-reply@calmobile.local
# MAIL_REPLY_TO=
# MAIL_SMTP_USER=
# MAIL_SMTP_PASSWORD=
# 自签名内网中继才需要关掉证书校验（默认 true）
# MAIL_SMTP_TLS_REJECT_UNAUTHORIZED=false
# MAIL_SEND_TIMEOUT_MS=8000

# CORS 配置：页面跑在 WebView 的 appassets.androidplatform.net 源下，
# 这里必须是那个源（或 *）。填 http://localhost:3000 只有浏览器直开前端时才成立，
# 真机 / 模拟器里会被 CORS 拦掉，表现成「连不到后端服务」
CORS_ORIGIN=https://appassets.androidplatform.net

# 开发便利项：应用接口是本机地址时，pnpm dev 会按那个端口自动 adb reverse
# （设备里的 127.0.0.1 是设备自己）。APP_API_BASE 不是本机地址时跳过。映射丢了会补回。
# 要自己管 adb 就设 0；adb 不在 PATH 时用 ADB 指定路径，多设备时用 ANDROID_SERIAL 选设备。
# ADB_REVERSE=0

# 日志级别
LOG_LEVEL=debug

# 语言包。默认名称是包里的 id。列表每一条是「名称=链接」，用逗号或空白分开，最多 8 条。
# 链接里不要再写逗号。生产只接受 https。报名站只有在默认名称非空、且这个名称写在列表里时才用它，否则用中文。
# 已安装到客户端的包不会被页面更新覆盖。改这里要改服务器上的环境文件并重启。
# LANG_PACK_DEFAULT=en
# LANG_PACK_URLS=en=https://example.com/en.json, ja=https://example.com/ja.json
