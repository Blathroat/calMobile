# 服务器配置
PORT=3000
NODE_ENV=development

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=calmobile_dev
DB_USER=postgres
DB_PASSWORD=postgres

# JWT 配置
# Generate unique random values with at least 32 characters for local use.
JWT_SECRET=replace-with-a-random-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-random-refresh-secret-at-least-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# 邮件配置（验证码与两步验证走这里）
# 通道：console（写日志，本地零配置）| smtp（真发信）| memory（仅测试，生产禁用）
# 开发指向 Mailpit：pwsh -File scripts\mail.ps1 start（SMTP 1025 / 收件箱 http://127.0.0.1:8025）
# 生产指向托管中继（阿里云邮件推送 / 腾讯云 SES / Resend 等），不要自建 SMTP
MAIL_TRANSPORT=smtp
MAIL_SMTP_HOST=127.0.0.1
MAIL_SMTP_PORT=1025
MAIL_SMTP_SECURE=false
# 生产必须显式配置发件人地址，并用该域名的 SPF / DKIM 记录
MAIL_FROM_ADDRESS=no-reply@calmobile.local
# MAIL_REPLY_TO=
# MAIL_SMTP_USER=
# MAIL_SMTP_PASSWORD=
# 自签名内网中继才需要关掉证书校验（默认 true）
# MAIL_SMTP_TLS_REJECT_UNAUTHORIZED=false
# MAIL_SEND_TIMEOUT_MS=8000

# CORS 配置
CORS_ORIGIN=http://localhost:3000

# 日志级别
LOG_LEVEL=debug
