{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["unicorn", "node"],
  "env": {
    "node": true
  },
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "eqeqeq": "error"
  },
  "ignorePatterns": ["pnpm-lock.yaml", "node_modules", "dist", "src/status-page-assets.ts"],
  "overrides": [
    {
      "files": ["src/**/*.test.ts", "test/**/*.ts"],
      "env": {
        "node": true,
        "vitest": true
      }
    }
  ]
}
