{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["unicorn", "node"],
  "env": {
    "node": true
  },
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "eqeqeq": "error"
  },
  "overrides": [
    {
      "files": ["src/**/*.test.js"],
      "env": {
        "node": true,
        "jest": true
      }
    },
    {
      "files": ["test/**/*.js"],
      "env": {
        "node": true
      },
      "globals": {
        "test": "readonly"
      }
    }
  ]
}
