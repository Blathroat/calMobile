{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["unicorn", "node"],
  "env": {
    "node": true
  },
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "eqeqeq": "error"
  },
  "overrides": [
    {
      "files": ["src/**/*.test.js", "src/**/*.test.ts", "test/**/*.js"],
      "env": {
        "node": true,
        "vitest": true
      }
    }
  ]
}
