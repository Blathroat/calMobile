{
  "name": "calmobile-server",
  "version": "1.0.0",
  "description": "展会排期助手后端服务器",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "node dist/index.js --production",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "lint": "oxlint src test vitest.config.mjs",
    "lint:fix": "oxlint --fix src test vitest.config.mjs",
    "format": "oxfmt src test vitest.config.mjs",
    "format:check": "oxfmt --check src test vitest.config.mjs",
    "db:migrate": "tsx src/config/migrate.ts migrate",
    "db:migrate:prod": "node dist/config/migrate.js migrate --production",
    "db:seed": "tsx src/config/migrate.ts seed"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "hono": "^4.13.8",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "nodemon": "^3.1.14",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
