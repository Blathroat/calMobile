{
  "name": "calmobile-server",
  "version": "1.0.0",
  "description": "展会排期助手后端服务器",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js --production",
    "dev": "nodemon src/index.js",
    "test": "jest",
    "test:contract": "node --test test/api.test.js",
    "lint": "oxlint src test",
    "lint:fix": "oxlint --fix src test",
    "format": "oxfmt src test",
    "format:check": "oxfmt --check src test",
    "db:migrate": "node src/config/migrate.js migrate",
    "db:migrate:prod": "node src/config/migrate.js migrate --production",
    "db:seed": "node src/config/migrate.js seed"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/src/**/*.test.js"
    ]
  }
}
