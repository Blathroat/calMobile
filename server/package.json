{
  "name": "calmobile-server",
  "version": "1.0.0",
  "description": "展会排期助手后端服务器",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js --production",
    "dev": "tsx watch --watch-path=src --watch-path=status-page scripts/dev.ts",
    "build": "tsx scripts/build-join.ts && tsx scripts/build-status-page.ts && tsc",
    "typecheck": "tsx scripts/build-status-page.ts && tsc --noEmit",
    "pretest": "tsx scripts/build-status-page.ts",
    "pretest:contract": "tsx scripts/build-status-page.ts",
    "prelint": "tsx scripts/build-status-page.ts",
    "preformat": "tsx scripts/build-status-page.ts",
    "preformat:check": "tsx scripts/build-status-page.ts",
    "test": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "lint": "oxlint src test scripts vitest.config.mjs",
    "lint:fix": "oxlint --fix src test scripts vitest.config.mjs",
    "format": "oxfmt src test scripts vitest.config.mjs",
    "format:check": "oxfmt --check src test scripts vitest.config.mjs",
    "db:migrate": "tsx src/config/migrate.ts migrate",
    "db:migrate:prod": "node dist/config/migrate.js migrate --production",
    "db:seed": "tsx src/config/migrate.ts seed"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.5",
    "hono": "^4.13.12",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@10.34.6"
}
